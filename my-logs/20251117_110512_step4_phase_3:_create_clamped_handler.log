{"type":"tool_use","timestamp":1763348730528,"sessionID":"ses_57039f04fffebU24XvTTct63C7","part":{"id":"prt_a8fc6529d001EH3dTOmY5CDbDw","sessionID":"ses_57039f04fffebU24XvTTct63C7","messageID":"msg_a8fc64649001jm4QtguNpx7KTH","type":"tool","callID":"call_544b3c3782844c63b41e6621","tool":"read","state":{"status":"completed","input":{"filePath":"/Users/nelsonpereira/Documents/GitHub/Auditing/Fuzzing/Recon_Fuzzing/Liquity_V2_Gov/V2-gov/test/recon/Setup.sol"},"output":"<file>\n00001| // SPDX-License-Identifier: GPL-2.0\n00002| pragma solidity ^0.8.0;\n00003| \n00004| // Chimera deps\n00005| import {BaseSetup} from \"@chimera/BaseSetup.sol\";\n00006| import {vm} from \"@chimera/Hevm.sol\";\n00007| \n00008| // Managers\n00009| import {ActorManager} from \"@recon/ActorManager.sol\";\n00010| import {AssetManager} from \"@recon/AssetManager.sol\";\n00011| \n00012| // Helpers\n00013| import {Utils} from \"@recon/Utils.sol\";\n00014| \n00015| // Your deps\n00016| import \"src/BribeInitiative.sol\";\n00017| import \"src/Governance.sol\";\n00018| import {IGovernance} from \"src/interfaces/IGovernance.sol\";\n00019| import {IERC20} from \"openzeppelin/contracts/interfaces/IERC20.sol\";\n00020| \n00021| // Mocks\n00022| import {MockERC20Tester} from \"../mocks/MockERC20Tester.sol\";\n00023| import {MockStakingV1} from \"../mocks/MockStakingV1.sol\";\n00024| \n00025| abstract contract Setup is BaseSetup, ActorManager, AssetManager, Utils {\n00026|     // Configuration constants\n00027|     uint256 internal constant DECIMALS = 18;\n00028| \n00029|     // Core contracts\n00030|     BribeInitiative bribeInitiative;\n00031|     Governance governance;\n00032| \n00033|     // Token contracts\n00034|     MockERC20Tester lqty;\n00035|     MockERC20Tester lusd;\n00036|     MockERC20Tester bold;\n00037|     MockERC20Tester bribeToken;\n00038| \n00039|     // Infrastructure contracts\n00040|     MockStakingV1 stakingV1;\n00041| \n00042|     /// === Setup === ///\n00043|     /// This contains all calls to be performed in the tester constructor, both for Echidna and Foundry\n00044|     function setup() internal virtual override {\n00045|         // 1. Add actors\n00046|         _addActor(address(0x100)); // Actor 1\n00047|         _addActor(address(0x200)); // Actor 2\n00048| \n00049|         // 2. Deploy tokens\n00050|         lqty = new MockERC20Tester(\"Liquity\", \"LQTY\");\n00051|         lusd = new MockERC20Tester(\"Liquity USD\", \"LUSD\");\n00052|         bold = new MockERC20Tester(\"BOLD Stablecoin\", \"BOLD\");\n00053|         bribeToken = new MockERC20Tester(\"Bribe Token\", \"BRYB\");\n00054| \n00055|         // 3. Deploy MockStakingV1\n00056|         stakingV1 = new MockStakingV1(lqty, lusd);\n00057| \n00058|         // Set wildcard spender for stakingV1 (like in real LQTYStaking)\n00059|         lqty.mock_setWildcardSpender(address(stakingV1), true);\n00060| \n00061|         // 4. Create governance configuration\n00062|         // CONFIGURABLE: These parameters can be modified via governance functions\n00063|         IGovernance.Configuration memory config = IGovernance.Configuration({\n00064|             registrationFee: 1e18,\n00065|             registrationThresholdFactor: 0.01e18,\n00066|             unregistrationThresholdFactor: 4e18,\n00067|             unregistrationAfterEpochs: 4,\n00068|             votingThresholdFactor: 0.04e18,\n00069|             minClaim: 500e18,\n00070|             minAccrual: 1000e18,\n00071|             epochStart: block.timestamp - (604800 * 3), // 3 weeks ago (to enable registration)\n00072|             epochDuration: 604800, // 1 week\n00073|             epochVotingCutoff: 518400 // 6 days\n00074|         });\n00075| \n00076|         // 5. Deploy governance\n00077|         address[] memory initialInitiatives = new address[](0);\n00078|         governance = new Governance(\n00079|             address(lqty),\n00080|             address(lusd),\n00081|             address(stakingV1),\n00082|             address(bold),\n00083|             config,\n00084|             address(this),\n00085|             initialInitiatives\n00086|         );\n00087| \n00088|         // 6. Deploy bribe initiative\n00089|         bribeInitiative = new BribeInitiative(\n00090|             address(governance),\n00091|             address(bold),\n00092|             address(bribeToken)\n00093|         );\n00094| \n00095|         // 7. Mint tokens to actors manually (MockERC20Tester has onlyOwner on mint)\n00096|         address[] memory actors = _getActors();\n00097|         uint256 mintAmount = type(uint88).max;\n00098| \n00099|         for (uint256 i = 0; i < actors.length; i++) {\n00100|             lqty.mint(actors[i], mintAmount);\n00101|             lusd.mint(actors[i], mintAmount);\n00102|             bold.mint(actors[i], mintAmount);\n00103|             bribeToken.mint(actors[i], mintAmount);\n00104|         }\n00105| \n00106|         // 8. Set up approvals for each actor to all relevant contracts\n00107|         // We need to approve: governance, bribeInitiative, stakingV1, and each actor's userProxy\n00108|         for (uint256 i = 0; i < actors.length; i++) {\n00109|             address userProxy = governance.deriveUserProxyAddress(actors[i]);\n00110| \n00111|             address[] memory approvalArray = new address[](4);\n00112|             approvalArray[0] = address(governance);\n00113|             approvalArray[1] = address(bribeInitiative);\n00114|             approvalArray[2] = address(stakingV1);\n00115|             approvalArray[3] = userProxy;\n00116| \n00117|             for (uint256 j = 0; j < approvalArray.length; j++) {\n00118|                 vm.prank(actors[i]);\n00119|                 lqty.approve(approvalArray[j], type(uint256).max);\n00120|                 vm.prank(actors[i]);\n00121|                 lusd.approve(approvalArray[j], type(uint256).max);\n00122|                 vm.prank(actors[i]);\n00123|                 bold.approve(approvalArray[j], type(uint256).max);\n00124|                 vm.prank(actors[i]);\n00125|                 bribeToken.approve(approvalArray[j], type(uint256).max);\n00126|             }\n00127|         }\n00128| \n00129|         // 9. Add custom tokens to asset manager\n00130|         _addAsset(address(lqty));\n00131|         _addAsset(address(lusd));\n00132|         _addAsset(address(bold));\n00133|         _addAsset(address(bribeToken));\n00134|     }\n00135| \n00136|     /// === MODIFIERS === ///\n00137|     /// Prank admin and actor\n00138| \n00139|     modifier asAdmin {\n00140|         vm.prank(address(this));\n00141|         _;\n00142|     }\n00143| \n00144|     modifier asActor {\n00145|         vm.prank(address(_getActor()));\n00146|         _;\n00147|     }\n00148| }\n00149| \n\n(End of file - total 149 lines)\n</file>","title":"test/recon/Setup.sol","metadata":{"preview":"// SPDX-License-Identifier: GPL-2.0\npragma solidity ^0.8.0;\n\n// Chimera deps\nimport {BaseSetup} from \"@chimera/BaseSetup.sol\";\nimport {vm} from \"@chimera/Hevm.sol\";\n\n// Managers\nimport {ActorManager} from \"@recon/ActorManager.sol\";\nimport {AssetManager} from \"@recon/AssetManager.sol\";\n\n// Helpers\nimport {Utils} from \"@recon/Utils.sol\";\n\n// Your deps\nimport \"src/BribeInitiative.sol\";\nimport \"src/Governance.sol\";\nimport {IGovernance} from \"src/interfaces/IGovernance.sol\";\nimport {IERC20} from \"openzeppelin/contracts/interfaces/IERC20.sol\";\n"},"time":{"start":1763348730527,"end":1763348730528}}}}
