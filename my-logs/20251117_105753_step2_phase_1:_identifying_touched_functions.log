tive.sol:BribeInitiative:_claimBribe(address,uint256,uint256,uint256)`\n00035| \n00036| ```solidity\n00037| function _claimBribe(address _user, uint256 _epoch, uint256 _prevLQTYAllocationEpoch, uint256 _prevTotalLQTYAllocationEpoch) internal returns (uint256 boldAmount, uint256 bribeTokenAmount) {\n00038|     require(_epoch < governance.epoch(), \"BribeInitiative: cannot-claim-for-current-epoch\");\n00039|     require(!claimedBribeAtEpoch[_user][_epoch], \"BribeInitiative: already-claimed\");\n00040|     Bribe memory bribe = bribeByEpoch[_epoch];\n00041|     require((bribe.remainingBoldAmount != 0) || (bribe.remainingBribeTokenAmount != 0), \"BribeInitiative: no-bribe\");\n00042|     DoubleLinkedList.Item memory lqtyAllocation = lqtyAllocationByUserAtEpoch[_user].getItem(_prevLQTYAllocationEpoch);\n00043|     require((_prevLQTYAllocationEpoch <= _epoch) && ((lqtyAllocation.next > _epoch) || (lqtyAllocation.next == 0)), \"BribeInitiative: invalid-prev-lqty-allocation-epoch\");\n00044|     DoubleLinkedList.Item memory totalLQTYAllocation = totalLQTYAllocationByEpoch.getItem(_prevTotalLQTYAllocationEpoch);\n00045|     require((_prevTotalLQTYAllocationEpoch <= _epoch) && ((totalLQTYAllocation.next > _epoch) || (totalLQTYAllocation.next == 0)), \"BribeInitiative: invalid-prev-total-lqty-allocation-epoch\");\n00046|     require(totalLQTYAllocation.lqty > 0, \"BribeInitiative: total-lqty-allocation-zero\");\n00047|     require(lqtyAllocation.lqty > 0, \"BribeInitiative: lqty-allocation-zero\");\n00048|     uint256 epochEnd = EPOCH_START + (_epoch * EPOCH_DURATION);\n00049|     uint256 totalVotes = _lqtyToVotes(totalLQTYAllocation.lqty, epochEnd, totalLQTYAllocation.offset);\n00050|     uint256 votes = _lqtyToVotes(lqtyAllocation.lqty, epochEnd, lqtyAllocation.offset);\n00051|     uint256 remainingVotes = totalVotes - bribe.claimedVotes;\n00052|     boldAmount = (bribe.remainingBoldAmount * votes) / remainingVotes;\n00053|     bribeTokenAmount = (bribe.remainingBribeTokenAmount * votes) / remainingVotes;\n00054|     bribe.remainingBoldAmount -= boldAmount;\n00055|     bribe.remainingBribeTokenAmount -= bribeTokenAmount;\n00056|     bribe.claimedVotes += votes;\n00057|     bribeByEpoch[_epoch] = bribe;\n00058|     claimedBribeAtEpoch[_user][_epoch] = true;\n00059|     emit ClaimBribe(_user, _epoch, boldAmount, bribeTokenAmount);\n00060| }\n00061| ```\n00062| \n00063| ### getItem(struct DoubleLinkedList.List,uint256)\n00064| \n00065| - **Kind**: internal\n00066| - **Source**: 2448:122:84\n00067| - **Link**: `src/utils/DoubleLinkedList.sol:DoubleLinkedList:getItem(struct DoubleLinkedList.List,uint256)`\n00068| \n00069| ```solidity\n00070| /// @notice Returns the item `id`\n00071| ///  @param list Linked list which contains the item\n00072| ///  @param id Id of the item\n00073| ///  @return _ Item\n00074| function getItem(List storage list, uint256 id) internal view returns (Item memory) {\n00075|     return list.items[id];\n00076| }\n00077| ```\n00078| \n00079| ### _lqtyToVotes(uint256,uint256,uint256)\n00080| \n00081| - **Kind**: free-function\n00082| - **Source**: 58:199:91\n00083| - **Link**: `src/utils/VotingPower.sol:_lqtyToVotes(uint256,uint256,uint256)`\n00084| \n00085| ```solidity\n00086| function _lqtyToVotes(uint256 _lqtyAmount, uint256 _timestamp, uint256 _offset) pure returns (uint256) {\n00087|     uint256 prod = _lqtyAmount * _timestamp;\n00088|     return (prod > _offset) ? (prod - _offset) : 0;\n00089| }\n00090| ```\n00091| \n00092| ## External Calls\n00093| \n00094| - **IERC20::safeTransfer(contract IERC20,address,uint256)**\n00095| \n00096| ## State Variable Reads\n00097| \n00098| - **bold** (`contract IERC20`) [lib/openzeppelin-contracts/contracts/token/ERC20/IERC20.sol/interface_IERC20.md]\n00099| - **bribeToken** (`contract IERC20`) [lib/openzeppelin-contracts/contracts/token/ERC20/IERC20.sol/interface_IERC20.md]\n00100| - **governance** (`contract IGovernance`) [src/interfaces/IGovernance.sol/interface_IGovernance.m