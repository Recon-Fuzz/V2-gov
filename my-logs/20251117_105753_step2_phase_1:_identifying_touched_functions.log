param list Linked list which contains the next item and into which the new item will be inserted\n00069| ///  @param id Id of the item to insert\n00070| ///  @param lqty amount of LQTY\n00071| ///  @param offset associated with the LQTY amount\n00072| ///  @param next Id of the item which should follow item `id`\n00073| function insert(List storage list, uint256 id, uint256 lqty, uint256 offset, uint256 next) internal {\n00074|     if (contains(list, id)) revert ItemInList();\n00075|     if ((next != 0) && (!contains(list, next))) revert ItemNotInList();\n00076|     uint256 prev = list.items[next].prev;\n00077|     list.items[prev].next = id;\n00078|     list.items[next].prev = id;\n00079|     list.items[id].prev = prev;\n00080|     list.items[id].next = next;\n00081|     list.items[id].lqty = lqty;\n00082|     list.items[id].offset = offset;\n00083| }\n00084| ```\n00085| \n00086| ### contains(struct DoubleLinkedList.List,uint256)\n00087| \n00088| - **Kind**: internal\n00089| - **Source**: 2810:224:84\n00090| - **Link**: `src/utils/DoubleLinkedList.sol:DoubleLinkedList:contains(struct DoubleLinkedList.List,uint256)`\n00091| \n00092| ```solidity\n00093| /// @notice Returns whether the list contains item `id`\n00094| ///  @param list Linked list which should contain the item\n00095| ///  @param id Id of the item to check\n00096| ///  @return _ True if the list contains the item, false otherwise\n00097| function contains(List storage list, uint256 id) internal view returns (bool) {\n00098|     if (id == 0) revert IdIsZero();\n00099|     return (((list.items[id].prev != 0) || (list.items[id].next != 0)) || (list.items[0].next == id));\n00100| }\n00101| ```\n00102| \n00103| ### _setLQTYAllocationByUserAtEpoch(address,uint256,uint256,uint256,bool)\n00104| \n00105| - **Kind**: internal\n00106| - **Source**: 7732:531:65\n00107| - **Link**: `src/BribeInitiative.sol:BribeInitiative:_setLQTYAllocationByUserAtEpoch(address,uint256,uint256,uint256,bool)`\n00108| \n00109| ```solidity\n00110| function _setLQTYAllocationByUserAtEpoch(address _user, uint256 _epoch, uint256 _lqty, uint256 _offset, bool _insert) private {\n00111|     if (_insert) {\n00112|         lqtyAllocationByUserAtEpoch[_user].insert(_epoch, _lqty, _offset, 0);\n00113|     } else {\n00114|         lqtyAllocationByUserAtEpoch[_user].items[_epoch].lqty = _lqty;\n00115|         lqtyAllocationByUserAtEpoch[_user].items[_epoch].offset = _offset;\n00116|     }\n00117|     emit ModifyLQTYAllocation(_user, _epoch, _lqty, _offset);\n00118| }\n00119| ```\n00120| \n00121| ### onlyGovernance()\n00122| \n00123| - **Kind**: modifier\n00124| - **Source**: 1897:131:65\n00125| - **Link**: `src/BribeInitiative.sol:BribeInitiative:onlyGovernance()`\n00126| \n00127| ```solidity\n00128| modifier onlyGovernance() {\n00129|     require(msg.sender == address(governance), \"BribeInitiative: invalid-sender\");\n00130|     _;\n00131| }\n00132| ```\n00133| \n00134| ## State Variable Reads\n00135| \n00136| - **lqtyAllocationByUserAtEpoch** (`mapping(address => struct DoubleLinkedList.List)`)\n00137| - **totalLQTYAllocationByEpoch** (`struct DoubleLinkedList.List`)\n00138| - **governance** (`contract IGovernance`) [src/interfaces/IGovernance.sol/interface_IGovernance.md]\n00139| \n00140| ## State Variable Writes\n00141| \n00142| - **totalLQTYAllocationByEpoch** (`struct DoubleLinkedList.List`)\n00143| - **lqtyAllocationByUserAtEpoch** (`mapping(address => struct DoubleLinkedList.List)`)\n00144| \n00145| ## Call Tree\n00146| \n00147| ```\n00148| ┌─ [0] ⚙️ FUNCTION: BribeInitiative.onAfterAllocateLQTY(uint256,address,struct IGovernance.UserState,struct IGovernance.Allocation,struct IGovernance.InitiativeState) (NodeID: 0)\n00149|     💬 Args: [no args]\n00150|     👁️  Def: external\n00151|   ├─ [1] ⚙️ FUNCTION: DoubleLinkedList.getHead(struct DoubleLinkedList.List) (NodeID: 1)\n00152|   │   💬 Args: [lqtyAllocationByUserAtEpoch[_user]]\n00153|   │   👁️  Def: internal\n00154|   ├─ [1] ⚙️ FUNCTION: DoubleLink