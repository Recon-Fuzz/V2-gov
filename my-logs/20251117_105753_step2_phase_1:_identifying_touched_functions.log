{"type":"tool_use","timestamp":1763348410233,"sessionID":"ses_57040a3e2ffeJkcDxvQwxpxUnc","part":{"id":"prt_a8fc16f710013suBXsQcdYzCIZ","sessionID":"ses_57040a3e2ffeJkcDxvQwxpxUnc","messageID":"msg_a8fc15f8b001UAvc1peaDfMxc6","type":"tool","callID":"call_97e72bac1b0d4bdbb75516c5","tool":"read","state":{"status":"completed","input":{"filePath":"/Users/nelsonpereira/Documents/GitHub/Auditing/Fuzzing/Recon_Fuzzing/Liquity_V2_Gov/V2-gov/context_output/src/Governance.sol/function_allocateLQTY_address[]_address[]_int256[]_int256[].md"},"output":"<file>\n00001| # Function: allocateLQTY(address[],address[],int256[],int256[])\n00002| \n00003| **Contract**: [src/Governance.sol/contract_Governance.md]\n00004| \n00005| ## Metadata\n00006| \n00007| - **Contract**: Governance\n00008| - **Signature**: `allocateLQTY(address[],address[],int256[],int256[])`\n00009| - **Visibility**: external\n00010| - **Source Range**: 24855:4250:67\n00011| \n00012| ## Implementation\n00013| \n00014| ```solidity\n00015| /// @inheritdoc IGovernance\n00016| function allocateLQTY(address[] calldata _initiativesToReset, address[] calldata _initiatives, int256[] calldata _absoluteLQTYVotes, int256[] calldata _absoluteLQTYVetos) external nonReentrant() {\n00017|     require((_initiatives.length == _absoluteLQTYVotes.length) && (_absoluteLQTYVotes.length == _absoluteLQTYVetos.length), \"Governance: array-length-mismatch\");\n00018|     _requireNoDuplicates(_initiativesToReset);\n00019|     _requireNoDuplicates(_initiatives);\n00020|     _requireNoNegatives(_absoluteLQTYVotes);\n00021|     _requireNoNegatives(_absoluteLQTYVetos);\n00022|     _requireNoNOP(_absoluteLQTYVotes, _absoluteLQTYVetos);\n00023|     _requireNoSimultaneousVoteAndVeto(_absoluteLQTYVotes, _absoluteLQTYVetos);\n00024|     ResetInitiativeData[] memory cachedData = _resetInitiatives(_initiativesToReset);\n00025|     /// Invariant, 0 allocated = 0 votes\n00026|     UserState memory userState = userStates[msg.sender];\n00027|     require(userState.allocatedLQTY == 0, \"must be a reset\");\n00028|     require(userState.unallocatedLQTY != 0, \"Governance: insufficient-or-allocated-lqty\");\n00029|     if (secondsWithinEpoch() > EPOCH_VOTING_CUTOFF) {\n00030|         for (uint256 x; x < _initiatives.length; x++) {\n00031|             bool found;\n00032|             for (uint256 y; y < cachedData.length; y++) {\n00033|                 if (cachedData[y].initiative == _initiatives[x]) {\n00034|                     found = true;\n00035|                     require(_absoluteLQTYVotes[x] <= cachedData[y].LQTYVotes, \"Cannot increase\");\n00036|                     break;\n00037|                 }\n00038|             }\n00039|             if (!found) {\n00040|                 require(_absoluteLQTYVotes[x] == 0, \"Must be zero for new initiatives\");\n00041|             }\n00042|         }\n00043|     }\n00044|     int256[] memory absoluteOffsetVotes = new int256[](_initiatives.length);\n00045|     int256[] memory absoluteOffsetVetos = new int256[](_initiatives.length);\n00046|     for (uint256 x; x < _initiatives.length; x++) {\n00047|         (int256[] calldata lqtyAmounts, int256[] memory offsets) = (_absoluteLQTYVotes[x] > 0) ? (_absoluteLQTYVotes, absoluteOffsetVotes) : (_absoluteLQTYVetos, absoluteOffsetVetos);\n00048|         uint256 lqtyAmount = uint256(lqtyAmounts[x]);\n00049|         uint256 offset = (userState.unallocatedOffset * lqtyAmount) / userState.unallocatedLQTY;\n00050|         userState.unallocatedLQTY -= lqtyAmount;\n00051|         userState.unallocatedOffset -= offset;\n00052|         offsets[x] = int256(offset);\n00053|     }\n00054|     _allocateLQTY(_initiatives, _absoluteLQTYVotes, _absoluteLQTYVetos, absoluteOffsetVotes, absoluteOffsetVetos);\n00055| }\n00056| ```\n00057| \n00058| ## Related Implementations\n00059| \n00060| ### _requireNoDuplicates(address[])\n00061| \n00062| - **Kind**: free-function\n00063| - **Source**: 150:445:90\n00064| - **Link**: `src/utils/UniqueArray.sol:_requireNoDuplicates(address[])`\n00065| \n00066| ```solidity\n00067| /// @dev Checks that there's no duplicate addresses\n00068| ///  @param arr - List to check for dups\n00069| function _requireNoDuplicates(address[] calldata arr) pure {\n00070|     uint256 arrLength = arr.length;\n00071|     if (arrLength == 0) return;\n00072|     for (uint i; i < (arrLength - 1); ) {\n00073|         for (uint j = i + 1; j < arrLength; ) {\n00074|             require(arr[i] != arr[j], \"dup\");\n00075|             unchecked {\n00076|                 ++j;\n00077|             }\n00078|         }\n00079|         unchecked {\n00080|             ++i;\n00081|         }\n00082|     }\n00083| }\n00084| ```\n00085| \n00086| ### _requireNoNegatives(int256[])\n00087| \n00088| - **Kind**: free-function\n00089| - **Source**: 597:195:90\n00090| - **Link**: `src/utils/UniqueArray.sol:_requireNoNegatives(int256[])`\n00091| \n00092| ```solidity\n00093| function _requireNoNegatives(int256[] memory vals) pure {\n00094|     uint256 arrLength = vals.length;\n00095|     for (uint i; i < arrLength; i++) {\n00096|         require(vals[i] >= 0, \"Cannot be negative\");\n00097|     }\n00098| }\n00099| ```\n00100| \n00101| ### _requireNoNOP(int256[],int256[])\n00102| \n00103| - **Kind**: internal\n00104| - **Source**: 41106:295:67\n00105| - **Link**: `src/Governance.sol:Governance:_requireNoNOP(int256[],int256[])`\n00106| \n00107| ```solidity\n00108| function _requireNoNOP(int256[] memory _absoluteLQTYVotes, int256[] memory _absoluteLQTYVetos) internal pure {\n00109|     for (uint256 i; i < _absoluteLQTYVotes.length; i++) {\n00110|         require((_absoluteLQTYVotes[i] > 0) || (_absoluteLQTYVetos[i] > 0), \"Governance: voting nothing\");\n00111|     }\n00112| }\n00113| ```\n00114| \n00115| ### _requireNoSimultaneousVoteAndVeto(int256[],int256[])\n00116| \n00117| - **Kind**: internal\n00118| - **Source**: 41407:336:67\n00119| - **Link**: `src/Governance.sol:Governance:_requireNoSimultaneousVoteAndVeto(int256[],int256[])`\n00120| \n00121| ```solidity\n00122| function _requireNoSimultaneousVoteAndVeto(int256[] memory _absoluteLQTYVotes, int256[] memory _absoluteLQTYVetos) internal pure {\n00123|     for (uint256 i; i < _absoluteLQTYVotes.length; i++) {\n00124|         require((_absoluteLQTYVotes[i] == 0) || (_absoluteLQTYVetos[i] == 0), \"Governance: vote-and-veto\");\n00125|     }\n00126| }\n00127| ```\n00128| \n00129| ### _resetInitiatives(address[])\n00130| \n00131| - **Kind**: internal\n00132| - **Source**: 22322:1808:67\n00133| - **Link**: `src/Governance.sol:Governance:_resetInitiatives(address[])`\n00134| \n00135| ```solidity\n00136| /// @dev Resets an initiative and return the previous votes\n00137| ///  NOTE: Technically we don't need vetos\n00138| ///  NOTE: Technically we want to populate the `ResetInitiativeData` only when `secondsWithinEpoch() > EPOCH_VOTING_CUTOFF`\n00139| function _resetInitiatives(address[] calldata _initiativesToReset) internal returns (ResetInitiativeData[] memory) {\n00140|     ResetInitiativeData[] memory cachedData = new ResetInitiativeData[](_initiativesToReset.length);\n00141|     int256[] memory deltaLQTYVotes = new int256[](_initiativesToReset.length);\n00142|     int256[] memory deltaLQTYVetos = new int256[](_initiativesToReset.length);\n00143|     int256[] memory deltaOffsetVotes = new int256[](_initiativesToReset.length);\n00144|     int256[] memory deltaOffsetVetos = new int256[](_initiativesToReset.length);\n00145|     for (uint256 i; i < _initiativesToReset.length; i++) {\n00146|         Allocation memory alloc = lqtyAllocatedByUserToInitiative[msg.sender][_initiativesToReset[i]];\n00147|         require((alloc.voteLQTY > 0) || (alloc.vetoLQTY > 0), \"Governance: nothing to reset\");\n00148|         cachedData[i] = ResetInitiativeData({initiative: _initiativesToReset[i], LQTYVotes: int256(alloc.voteLQTY), LQTYVetos: int256(alloc.vetoLQTY), OffsetVotes: int256(alloc.voteOffset), OffsetVetos: int256(alloc.vetoOffset)});\n00149|         deltaLQTYVotes[i] = -(cachedData[i].LQTYVotes);\n00150|         deltaLQTYVetos[i] = -(cachedData[i].LQTYVetos);\n00151|         deltaOffsetVotes[i] = -(cachedData[i].OffsetVotes);\n00152|         deltaOffsetVetos[i] = -(cachedData[i].OffsetVetos);\n00153|     }\n00154|     _allocateLQTY(_initiativesToReset, deltaLQTYVotes, deltaLQTYVetos, deltaOffsetVotes, deltaOffsetVetos);\n00155|     return cachedData;\n00156| }\n00157| ```\n00158| \n00159| ### _allocateLQTY(address[],int256[],int256[],int256[],int256[])\n00160| \n00161| - **Kind**: internal\n00162| - **Source**: 30035:7437:67\n00163| - **Link**: `src/Governance.sol:Governance:_allocateLQTY(address[],int256[],int256[],int256[],int256[])`\n00164| \n00165| ```solidity\n00166| /// @dev For each given initiative applies relative changes to the allocation\n00167| ///  @dev Assumes that all the input arrays are of equal length\n00168| ///  @dev NOTE: Given the current usage the function either: Resets the value to 0, or sets the value to a new value\n00169| ///       Review the flows as the function could be used in many ways, but it ends up being used in just those 2 ways\n00170| function _allocateLQTY(address[] memory _initiatives, int256[] memory _deltaLQTYVotes, int256[] memory _deltaLQTYVetos, int256[] memory _deltaOffsetVotes, int256[] memory _deltaOffsetVetos) internal {\n00171|     AllocateLQTYMemory memory vars;\n00172|     (vars.votesSnapshot_, vars.state) = _snapshotVotes();\n00173|     vars.currentEpoch = epoch();\n00174|     vars.userState = userStates[msg.sender];\n00175|     for (uint256 i = 0; i < _initiatives.length; i++) {\n00176|         address initiative = _initiatives[i];\n00177|         vars.deltaLQTYVotes = _deltaLQTYVotes[i];\n00178|         vars.deltaLQTYVetos = _deltaLQTYVetos[i];\n00179|         assert((vars.deltaLQTYVotes != 0) || (vars.deltaLQTYVetos != 0));\n00180|         vars.deltaOffsetVotes = _deltaOffsetVotes[i];\n00181|         vars.deltaOffsetVetos = _deltaOffsetVetos[i];\n0