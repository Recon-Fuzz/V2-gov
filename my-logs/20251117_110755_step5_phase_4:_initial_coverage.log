0 public immutable bold;\n00037|     /// @inheritdoc IGovernance\n00038|     uint256 public immutable EPOCH_START;\n00039|     /// @inheritdoc IGovernance\n00040|     uint256 public immutable EPOCH_DURATION;\n00041|     /// @inheritdoc IGovernance\n00042|     uint256 public immutable EPOCH_VOTING_CUTOFF;\n00043|     /// @inheritdoc IGovernance\n00044|     uint256 public immutable MIN_CLAIM;\n00045|     /// @inheritdoc IGovernance\n00046|     uint256 public immutable MIN_ACCRUAL;\n00047|     /// @inheritdoc IGovernance\n00048|     uint256 public immutable REGISTRATION_FEE;\n00049|     /// @inheritdoc IGovernance\n00050|     uint256 public immutable REGISTRATION_THRESHOLD_FACTOR;\n00051|     /// @inheritdoc IGovernance\n00052|     uint256 public immutable UNREGISTRATION_THRESHOLD_FACTOR;\n00053|     /// @inheritdoc IGovernance\n00054|     uint256 public immutable UNREGISTRATION_AFTER_EPOCHS;\n00055|     /// @inheritdoc IGovernance\n00056|     uint256 public immutable VOTING_THRESHOLD_FACTOR;\n00057| \n00058|     /// @inheritdoc IGovernance\n00059|     uint256 public boldAccrued;\n00060| \n00061|     /// @inheritdoc IGovernance\n00062|     VoteSnapshot public votesSnapshot;\n00063|     /// @inheritdoc IGovernance\n00064|     mapping(address => InitiativeVoteSnapshot) public votesForInitiativeSnapshot;\n00065| \n00066|     /// @inheritdoc IGovernance\n00067|     GlobalState public globalState;\n00068|     /// @inheritdoc IGovernance\n00069|     mapping(address => UserState) public userStates;\n00070|     /// @inheritdoc IGovernance\n00071|     mapping(address => InitiativeState) public initiativeStates;\n00072|     /// @inheritdoc IGovernance\n00073|     mapping(address => mapping(address => Allocation)) public lqtyAllocatedByUserToInitiative;\n00074|     /// @inheritdoc IGovernance\n00075|     mapping(address => uint256) public override registeredInitiatives;\n00076| \n00077|     constructor(\n00078|         address _lqty,\n00079|         address _lusd,\n00080|         address _stakingV1,\n00081|         address _bold,\n00082|         Configuration memory _config,\n00083|         address _owner,\n00084|         address[] memory _initiatives\n00085|     ) UserProxyFactory(_lqty, _lusd, _stakingV1) Ownable(_owner) {\n00086|         stakingV1 = ILQTYStaking(_stakingV1);\n00087|         lqty = IERC20(_lqty);\n00088|         bold = IERC20(_bold);\n00089|         require(_config.minClaim <= _config.minAccrual, \"Gov: min-claim-gt-min-accrual\");\n00090|         REGISTRATION_FEE = _config.registrationFee;\n00091| \n00092|         // Registration threshold must be below 100% of votes\n00093|         require(_config.registrationThresholdFactor < WAD, \"Gov: registration-config\");\n00094|         REGISTRATION_THRESHOLD_FACTOR = _config.registrationThresholdFactor;\n00095| \n00096|         // Unregistration must be X times above the `votingThreshold`\n00097|         require(_config.unregistrationThresholdFactor > WAD, \"Gov: unregistration-config\");\n00098|         UNREGISTRATION_THRESHOLD_FACTOR = _config.unregistrationThresholdFactor;\n00099|         UNREGISTRATION_AFTER_EPOCHS = _config.unregistrationAfterEpochs;\n00100| \n\n(File has more lines. Use 'offset' parameter to read beyond line 100)\n</file>","title":"src/Governance.sol","metadata":{"preview":"// SPDX-License-Identifier: MIT\npragma solidity 0.8.24;\n\nimport {IERC20} from \"openzeppelin/contracts/interfaces/IERC20.sol\";\nimport {SafeERC20} from \"openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol\";\nimport {ReentrancyGuard} from \"openzeppelin/contracts/utils/ReentrancyGuard.sol\";\n\nimport {IGovernance, UNREGISTERED_INITIATIVE} from \"./interfaces/IGovernance.sol\";\nimport {IInitiative} from \"./interfaces/IInitiative.sol\";\nimport {ILQTYStaking} from \"./interfaces/ILQTYStaking.sol\";\n\nimport {UserProxy} from \"./UserProxy.sol\";\nimport {UserProxyFactory} from \"./UserProxyFactory.sol\";\n\nimport {add, sub, max} from \"./utils/Math.sol\";\nimport {_requireNoD