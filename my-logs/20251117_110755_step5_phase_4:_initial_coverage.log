   /// @inheritdoc IBribeInitiative\n00029|     mapping(uint256 => Bribe) public bribeByEpoch;\n00030|     /// @inheritdoc IBribeInitiative\n00031|     mapping(address => mapping(uint256 => bool)) public claimedBribeAtEpoch;\n00032| \n00033|     /// Double linked list of the total LQTY allocated at a given epoch\n00034|     DoubleLinkedList.List internal totalLQTYAllocationByEpoch;\n00035|     /// Double linked list of LQTY allocated by a user at a given epoch\n00036|     mapping(address => DoubleLinkedList.List) internal lqtyAllocationByUserAtEpoch;\n00037| \n00038|     constructor(address _governance, address _bold, address _bribeToken) {\n00039|         require(_bribeToken != _bold, \"BribeInitiative: bribe-token-cannot-be-bold\");\n00040| \n00041|         governance = IGovernance(_governance);\n00042|         bold = IERC20(_bold);\n00043|         bribeToken = IERC20(_bribeToken);\n00044| \n00045|         EPOCH_START = governance.EPOCH_START();\n00046|         EPOCH_DURATION = governance.EPOCH_DURATION();\n00047|     }\n00048| \n00049|     modifier onlyGovernance() {\n00050|         require(msg.sender == address(governance), \"BribeInitiative: invalid-sender\");\n00051|         _;\n00052|     }\n00053| \n00054|     /// @inheritdoc IBribeInitiative\n00055|     function totalLQTYAllocatedByEpoch(uint256 _epoch) external view returns (uint256, uint256, uint256, uint256) {\n00056|         return (\n00057|             totalLQTYAllocationByEpoch.items[_epoch].lqty,\n00058|             totalLQTYAllocationByEpoch.items[_epoch].offset,\n00059|             totalLQTYAllocationByEpoch.items[_epoch].prev,\n00060|             totalLQTYAllocationByEpoch.items[_epoch].next\n00061|         );\n00062|     }\n00063| \n00064|     /// @inheritdoc IBribeInitiative\n00065|     function lqtyAllocatedByUserAtEpoch(address _user, uint256 _epoch)\n00066|         external\n00067|         view\n00068|         returns (uint256, uint256, uint256, uint256)\n00069|     {\n00070|         return (\n00071|             lqtyAllocationByUserAtEpoch[_user].items[_epoch].lqty,\n00072|             lqtyAllocationByUserAtEpoch[_user].items[_epoch].offset,\n00073|             lqtyAllocationByUserAtEpoch[_user].items[_epoch].prev,\n00074|             lqtyAllocationByUserAtEpoch[_user].items[_epoch].next\n00075|         );\n00076|     }\n00077| \n00078|     /// @inheritdoc IBribeInitiative\n00079|     function depositBribe(uint256 _boldAmount, uint256 _bribeTokenAmount, uint256 _epoch) external {\n00080|         uint256 epoch = governance.epoch();\n00081|         require(_epoch >= epoch, \"BribeInitiative: now-or-future-epochs\");\n00082| \n00083|         bribeByEpoch[_epoch].remainingBoldAmount += _boldAmount;\n00084|         bribeByEpoch[_epoch].remainingBribeTokenAmount += _bribeTokenAmount;\n00085| \n00086|         emit DepositBribe(msg.sender, _boldAmount, _bribeTokenAmount, _epoch);\n00087| \n00088|         bold.safeTransferFrom(msg.sender, address(this), _boldAmount);\n00089|         bribeToken.safeTransferFrom(msg.sender, address(this), _bribeTokenAmount);\n00090|     }\n00091| \n00092|     function _claimBribe(\n00093|         address _user,\n00094|         uint256 _epoch,\n00095|         uint256 _prevLQTYAllocationEpoch,\n00096|         uint256 _prevTotalLQTYAllocationEpoch\n00097|     ) internal returns (uint256 boldAmount, uint256 bribeTokenAmount) {\n00098|         require(_epoch < governance.epoch(), \"BribeInitiative: cannot-claim-for-current-epoch\");\n00099|         require(!claimedBribeAtEpoch[_user][_epoch], \"BribeInitiative: already-claimed\");\n00100| \n\n(File has more lines. Use 'offset' parameter to read beyond line 100)\n</file>","title":"src/BribeInitiative.sol","metadata":{"preview":"// SPDX-License-Identifier: MIT\npragma solidity 0.8.24;\n\nimport {IERC20} from \"openzeppelin/contracts/interfaces/IERC20.sol\";\nimport {SafeERC20} from \"openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol\";\n\nimport {IGovernance, UNREGISTERED_INITIATIVE